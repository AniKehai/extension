{
	"name": "anikehai",
	"private": true,
	"version": "2.6.2",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"engines": {
		"node": ">=25.8.2",
		"bun": ">=1.3.14"
	},
	"scripts": {
		"dev:chrome": "wxt",
		"dev:firefox": "wxt -b firefox",
		"build:chrome": "wxt build",
		"build:firefox": "wxt build -b firefox",
		"zip:chrome": "wxt zip",
		"zip:firefox": "wxt zip -b firefox",
		"typecheck": "tsc --noEmit",
		"lint": "bunx biome check",
		"lint:fix": "bunx biome check --write",
		"format": "bunx biome format --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:health": "playwright test --config=playwright.health.config.ts",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "wxt build && playwright test",
		"test:e2e:install": "playwright install --with-deps chromium",
		"validate": "bun run lint && bun run typecheck && bun run test",
		"docker:dev": "docker compose up --build dev",
		"docker:dev:firefox": "docker compose up --build dev-firefox",
		"docker:shell": "docker compose run --rm --build shell",
		"docker:lint": "docker compose run --rm --build lint",
		"docker:test": "docker compose run --rm --build test",
		"docker:build": "docker compose run --rm --build build",
		"docker:e2e": "docker compose run --rm --build e2e",
		"docker:health": "docker compose run --rm --build health",
		"docker:ci": "docker compose run --rm --build ci",
		"docker:clean": "docker compose --profile dev --profile ci down --volumes --rmi local",
		"postinstall": "wxt prepare"
	},
	"dependencies": {
		"lucide-react": "^1.55.0",
		"motion": "^14.1.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.4",
		"@wxt-dev/module-react": "^1.2.2",
		"happy-dom": "^21.0.1",
		"lefthook": "^2.2.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.4",
		"web-ext": "^10.7.0",
		"wxt": "^0.21.4"
	}
}
