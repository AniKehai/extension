{
    "name": "anikehai",
    "private": true,
    "version": "2.9.2",
    "type": "module",
    "packageManager": "bun@1.4.3",
    "engines": {
        "node": ">=26",
        "bun": ">=1.4.3"
    },
    "scripts": {
        "dev:chrome": "wxt",
        "dev:firefox": "wxt -b firefox",
        "dev:edge": "wxt -b edge",
        "build:chrome": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "build:edge": "wxt build -b edge",
        "zip:chrome": "wxt zip",
        "zip:firefox": "wxt zip -b firefox",
        "zip:edge": "wxt zip -b edge",
        "typecheck": "tsc --noEmit",
        "lint": "bunx biome check",
        "lint:fix": "bunx biome check --write",
        "format": "bunx biome format --write",
        "validate": "bun run lint && bun run typecheck",
        "postinstall": "wxt prepare && lefthook install"
    },
    "dependencies": {
        "@sentry/browser": "^11.19.0",
        "lucide-react": "^1.82.0",
        "motion": "^14.14.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.9",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@sentry/cli": "^3.8.2",
        "@tailwindcss/vite": "^4.3.5",
        "@types/bun": "^1.4.5",
        "@types/react": "^19.3.3",
        "@types/react-dom": "^19.3.0",
        "@wxt-dev/module-react": "^1.2.2",
        "lefthook": "^2.2.4",
        "tailwindcss": "^4.3.5",
        "typescript": "^7.0.2",
        "vite": "^8.4.0",
        "web-ext": "^10.8.0",
        "wxt": "^0.21.5"
    },
    "trustedDependencies": [
        "@sentry/cli",
        "lefthook"
    ]
}
